{
  "name": "psx-runtime-ts",
  "version": "0.99.0",
  "description": "TypeScript runtime for playing user-supplied PlayStation games in the browser",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/core",
    "!dist/harness-build",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "check": "run-s check:src check:tests",
    "check:src": "tsc --noEmit",
    "check:tests": "tsc -p tsconfig.tests.json",
    "clean": "node scripts/clean-dist.mjs",
    "compile": "tsc",
    "compile:package": "tsc -p tsconfig.package.json",
    "build": "run-s clean compile",
    "build:package": "run-s clean compile:package",
    "build:core": "run-s build:package compile:core build:harness",
    "compile:core": "node --import tsx scripts/build-core.ts",
    "build:harness": "tsc -p tsconfig.harness.json",
    "build:ui": "tsc -p tsconfig.ui.json",
    "build:web": "run-s build:core build:ui",
    "build:fixture": "node scripts/build-fixture.mjs",
    "probe:workerfs": "node core/probes/run-browser-probe.mjs workerfs",
    "probe:pcsx": "node core/probes/run-browser-probe.mjs pcsx",
    "probe:beetle": "node core/probes/run-browser-probe.mjs beetle",
    "probe:endurance": "node core/probes/run-browser-probe.mjs endurance",
    "probe:geometry": "node core/probes/run-browser-probe.mjs geometry",
    "probe:media": "node core/probes/run-browser-probe.mjs media",
    "probe:cards": "node core/probes/run-browser-probe.mjs cards",
    "probe:state-disc": "node core/probes/run-browser-probe.mjs stateDisc",
    "probe:memory": "node core/probes/run-browser-probe.mjs memory",
    "probe:bios": "node core/probes/run-browser-probe.mjs bios",
    "probe:m4": "node core/probes/run-browser-probe.mjs m4",
    "probe:m6": "npm run build:package && node core/probes/run-browser-probe.mjs m6",
    "probe:m7": "npm run build:package && node core/probes/run-browser-probe.mjs m7",
    "probe:m8": "npm run build:harness && node core/probes/run-browser-probe.mjs m8",
    "probe:m9": "npm run build:package && node core/probes/run-browser-probe.mjs m9",
    "probe:m10": "node core/probes/run-browser-probe.mjs m10",
    "probe:m11": "npm run build:harness && node core/probes/run-browser-probe.mjs m11",
    "probe:ui": "npm run build:web && node core/probes/run-browser-probe.mjs m12",
    "probe:m13": "npm run build:ui && node core/probes/run-browser-probe.mjs m13",
    "serve:harness": "npm run build:harness && node scripts/serve-harness.mjs",
    "serve:ui": "npm run build:web && node scripts/serve-ui.mjs",
    "audit:package": "node scripts/audit-package.mjs",
    "gate:m9": "run-s check test:spec test:shim probe:m9 audit:package",
    "verify:evidence": "node scripts/verify-release-evidence.mjs --automated",
    "verify:evidence:full": "node scripts/verify-release-evidence.mjs",
    "verify:repro": "node scripts/verify-reproducibility.mjs",
    "gate:v1:automated": "run-s check test:spec test:shim build:package verify:evidence verify:repro build:core probe:m10 audit:package",
    "gate:v1": "run-s gate:v1:automated verify:evidence:full",
    "test": "node --import tsx tests/run.ts spec",
    "test:spec": "node --import tsx tests/run.ts spec",
    "test:shim": "node scripts/test-native-shim.mjs",
    "test:browser": "node --import tsx tests/run.ts browser",
    "test:all": "node --import tsx tests/run.ts spec browser"
  },
  "author": "mastergray",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mastergray/psx-runtime-ts.git"
  },
  "homepage": "https://github.com/mastergray/psx-runtime-ts#readme",
  "bugs": {
    "url": "https://github.com/mastergray/psx-runtime-ts/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ctg-js-browser-test": "github:claymoretechgroup/ctg-js-browser-test#v2.0.0",
    "ctg-js-test": "github:claymoretechgroup/ctg-js-test#v4.0.0",
    "esbuild": "0.28.2",
    "npm-run-all": "^4.1.5",
    "playwright": "1.62.0",
    "tsx": "^4.23.11",
    "typescript": "^5.9.0"
  },
  "dependencies": {
    "fflate": "^0.8.3"
  }
}
